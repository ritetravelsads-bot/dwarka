Options -Indexes

# Enable URL rewriting
RewriteEngine On
RewriteBase /

# =======================================================
# 1. FORCE HTTPS AND WWW (SEO Fix)
# =======================================================
# This ensures Google always sees https://www.dwarkaexpresswayncr.com
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^dwarkaexpresswayncr\.com$ [NC]
RewriteRule ^(.*)$ https://www.dwarkaexpresswayncr.com/$1 [L,R=301]

# =======================================================
# 1.5 GSC DUPLICATE FIX (Force Clean URLs)
# =======================================================
# Redirect projects.php?slug=project-name to /project-name
RewriteCond %{THE_REQUEST} \s/+projects\.php\?slug=([A-Za-z0-9\-]+) [NC]
RewriteRule ^ /%1? [R=301,L]

# =======================================================
# 1.6 REDIRECT INDEX.PHP TO ROOT HOMEPAGE
# =======================================================
RewriteCond %{THE_REQUEST} ^.*/index\.php
RewriteRule ^(.*)index\.php$ /$1 [R=301,L]

# =======================================================
# 2. FILE SYSTEM & CLEANUP
# =======================================================
# Strip accidental filesystem prefixes
RewriteRule ^home/[^/]+/public_html/(.*)$ /$1 [L,R=301,NC]

# If requested path is an actual file or directory, do nothing
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# =======================================================
# 3. CUSTOM PAGE RULES
# =======================================================
RewriteRule ^about/?$ about.php [L]
RewriteRule ^amenities/?$ amenities.php [L]
RewriteRule ^projects-search/?$ projects-search.php [L]
RewriteRule ^contact/?$ contact.php [L]
RewriteRule ^connectivity/?$ connectivity.php [L]
RewriteRule ^projects/?$ projects.php [L,QSA,NC]

# Handle property-detail (Two-segment paths)
RewriteRule ^([A-Za-z0-9_-]+)/([A-Za-z0-9_-]+)/?$ property-detail.php?slug=$1/$2 [L,QSA,NC]

# Handle root project slugs (Single-segment paths)
RewriteRule ^([A-Za-z0-9\-]+)/?$ projects.php?slug=$1 [L,QSA,NC]

# =======================================================
# 5. CATCH-ALL REDIRECT (Send missing pages to Home)
# =======================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Do not redirect missing images, css, or js files (let them naturally 404)
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|webp|svg|ico)$ [NC]
# Redirect everything else to the home page permanently
RewriteRule ^(.*)$ https://www.dwarkaexpresswayncr.com/ [L,R=301]

# =======================================================
# 4. BROWSER CACHING RULES (Speed Fix)
# =======================================================
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images (Cache for 1 Year)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS & JS (Cache for 1 Month)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    # Fonts (Cache for 1 Year)
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit